\i common/common_setup.sql
CREATE EXTENSION IF NOT EXISTS pg_search;
-- Disable parallel workers to avoid differences in plans
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan to OFF;
SET paradedb.enable_columnar_exec = true;
-- Window functions over a GROUP BY must see every group, even when the query
-- has a LIMIT (issue #6830). The LIMIT applies after the WindowAgg, so the
-- Aggregate Scan must not fold it into the terms aggregation bucket size.
SET paradedb.enable_aggregate_custom_scan TO on;
DROP TABLE IF EXISTS issue_6830 CASCADE;
CREATE TABLE issue_6830 (id SERIAL PRIMARY KEY, n INT);
INSERT INTO issue_6830 (n) VALUES (1), (2), (3);
CREATE INDEX issue_6830_idx ON issue_6830 USING paradedb (id, n);
-- Test 1: the issue's repro (no ORDER BY). Expected: total = 6, num_groups = 3.
EXPLAIN (COSTS OFF, TIMING OFF, VERBOSE)
SELECT SUM(n) OVER () AS total, COUNT(*) OVER () AS num_groups
FROM issue_6830
WHERE id @@@ pdb.all()
GROUP BY n
LIMIT 1;
                                                 QUERY PLAN                                                  
-------------------------------------------------------------------------------------------------------------
 Limit
   Output: (sum(n) OVER w1), (count(*) OVER w1), n
   ->  WindowAgg
         Output: sum(n) OVER w1, count(*) OVER w1, n
         Window: w1 AS ()
         ->  Custom Scan (ParadeDB Aggregate Scan) on public.issue_6830
               Output: n
               Index: issue_6830_idx
               Tantivy Query: {"with_index":{"query":{"all":{"field":"id"}}}}
                 Applies to Aggregates: 
                 Group By: n
                 Aggregate Definition: {"grouped":{"terms":{"field":"n","segment_size":65000,"size":65000}}}
(12 rows)

SELECT SUM(n) OVER () AS total, COUNT(*) OVER () AS num_groups
FROM issue_6830
WHERE id @@@ pdb.all()
GROUP BY n
LIMIT 1;
 total | num_groups 
-------+------------
     6 |          3
(1 row)

-- Test 2: LIMIT + OFFSET. Expected: total = 6, num_groups = 3.
EXPLAIN (COSTS OFF, TIMING OFF, VERBOSE)
SELECT SUM(n) OVER () AS total, COUNT(*) OVER () AS num_groups
FROM issue_6830
WHERE id @@@ pdb.all()
GROUP BY n
LIMIT 1 OFFSET 1;
                                                 QUERY PLAN                                                  
-------------------------------------------------------------------------------------------------------------
 Limit
   Output: (sum(n) OVER w1), (count(*) OVER w1), n
   ->  WindowAgg
         Output: sum(n) OVER w1, count(*) OVER w1, n
         Window: w1 AS ()
         ->  Custom Scan (ParadeDB Aggregate Scan) on public.issue_6830
               Output: n
               Index: issue_6830_idx
               Tantivy Query: {"with_index":{"query":{"all":{"field":"id"}}}}
                 Applies to Aggregates: 
                 Group By: n
                 Aggregate Definition: {"grouped":{"terms":{"field":"n","segment_size":65000,"size":65000}}}
(12 rows)

SELECT SUM(n) OVER () AS total, COUNT(*) OVER () AS num_groups
FROM issue_6830
WHERE id @@@ pdb.all()
GROUP BY n
LIMIT 1 OFFSET 1;
 total | num_groups 
-------+------------
     6 |          3
(1 row)

-- Test 3: ORDER BY an aggregate that TopK accepts. Expected: total = 6, num_groups = 3.
EXPLAIN (COSTS OFF, TIMING OFF, VERBOSE)
SELECT SUM(n) OVER () AS total, COUNT(*) OVER () AS num_groups
FROM issue_6830
WHERE id @@@ pdb.all()
GROUP BY n
ORDER BY COUNT(*) DESC
LIMIT 1;
                                                                   QUERY PLAN                                                                    
-------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: (sum(n) OVER w1), (count(*) OVER w1), (count(*)), n
   ->  Sort
         Output: (sum(n) OVER w1), (count(*) OVER w1), (count(*)), n
         Sort Key: (count(*)) DESC
         ->  WindowAgg
               Output: sum(n) OVER w1, count(*) OVER w1, (count(*)), n
               Window: w1 AS ()
               ->  Custom Scan (ParadeDB Aggregate Scan)
                     Output: n, (count(*))
                     Backend: DataFusion
                     Indexes: issue_6830_idx (issue_6830)
                     Group By: n
                     Aggregates: COUNT(*)
                     DataFusion Physical Plan: 
                       : AggregateExec: mode=Single, gby=[n@0 as n], aggr=[count(1) as agg_0]
                       :   CooperativeExec
                       :     PgSearchScan: table=issue_6830, segments=1, visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
(18 rows)

SELECT SUM(n) OVER () AS total, COUNT(*) OVER () AS num_groups
FROM issue_6830
WHERE id @@@ pdb.all()
GROUP BY n
ORDER BY COUNT(*) DESC
LIMIT 1;
 total | num_groups 
-------+------------
     6 |          3
(1 row)

-- Test 4: without a window function the LIMIT is still pushed into the bucket size.
EXPLAIN (COSTS OFF, TIMING OFF, VERBOSE)
SELECT n, COUNT(*)
FROM issue_6830
WHERE id @@@ pdb.all()
GROUP BY n
LIMIT 1;
                                            QUERY PLAN                                             
---------------------------------------------------------------------------------------------------
 Limit
   Output: n, (pdb.agg_fn('COUNT(*)'::text))
   ->  Custom Scan (ParadeDB Aggregate Scan) on public.issue_6830
         Output: n, pdb.agg_fn('COUNT(*)'::text)
         Index: issue_6830_idx
         Tantivy Query: {"with_index":{"query":{"all":{"field":"id"}}}}
           Applies to Aggregates: COUNT(*)
           Group By: n
           Limit: 1
           Aggregate Definition: {"grouped":{"terms":{"field":"n","segment_size":65000,"size":1}}}
(10 rows)

-- Test 5: same results as with the Aggregate Scan disabled.
SET paradedb.enable_aggregate_custom_scan TO off;
SELECT SUM(n) OVER () AS total, COUNT(*) OVER () AS num_groups
FROM issue_6830
WHERE id @@@ pdb.all()
GROUP BY n
LIMIT 1;
 total | num_groups 
-------+------------
     6 |          3
(1 row)

RESET paradedb.enable_aggregate_custom_scan;
DROP TABLE issue_6830;
\i common/common_cleanup.sql
-- Reset parallel workers setting to default
RESET max_parallel_workers_per_gather;
RESET enable_indexscan;
RESET paradedb.enable_columnar_exec;
SELECT 'Common tests cleanup complete' AS status; 
            status             
-------------------------------
 Common tests cleanup complete
(1 row)

